  "inscriptions": [
    {
      "x": 155,
      "y": 510,
      "text": "「绝风断塔 · 踏入青白罡风即可御风浮升」",
      "hideInNgPlus": true
    },
    {
      "x": 1075,
      "y": 510,
      "text": "「东出断塔 · 直抵初钟圣阶上层捷径 →」"
    },
    {
      "x": 580,
      "y": 515,
      "text": "脚下铁栅连通沉渊古炉 — 千年熔金热浪化作永续罡风，乘风直上可抵「千铃悬桥」"
    },
    {
      "x": 545,
      "y": 302,
      "text": "「换向风铃 · 击鸣可反转双井罡风侧向气流」",
      "hideInNgPlus": true
    },
    {
      "x": 95,
      "y": 520,
      "text": "「启闸开启西侧铁闸 · 贯通回沉渊钟井上层」",
      "hideWhenSwitch": "windWestOpen"
    }
  ],
